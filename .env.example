OPENAI_API_KEY=

# Storage and publishing pipeline.
CLOUDFLARE_R2_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

N8N_WEBHOOK_URL=
UPLOAD_POST_API_KEY=
UPLOAD_POST_USER=

# Telegram / n8n AI agent.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_AGENT_SECRET=

# Supabase memory for n8n.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# n8n Postgres Chat Memory.
# Fill these from Supabase Project Settings > Database > Connection string.
# Prefer the Supabase pooler for n8n; keep SSL required/enabled.
N8N_MEMORY_POSTGRES_HOST=
N8N_MEMORY_POSTGRES_PORT=
N8N_MEMORY_POSTGRES_DATABASE=postgres
N8N_MEMORY_POSTGRES_USER=
N8N_MEMORY_POSTGRES_PASSWORD=
N8N_MEMORY_POSTGRES_SSL=true
N8N_MEMORY_POSTGRES_TABLE=n8n_chat_histories

# Public/static page, local tunnel, and production API.
APP_URL=https://issa-diallo.github.io/word-cup-maestro
APP_URL_LOCAL=
APP_URL_PROD=https://api.example.com
NODE_ENV=production
CLIPPING_MAX_SOURCE_SECONDS=900
TELEGRAM_CLIP_MAX_QUEUED_JOBS=10
# Optional: override persisted Telegram job state file. Defaults to output/telegram-clip-jobs.json.
TELEGRAM_CLIP_JOBS_STATE_PATH=
