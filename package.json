{
  "name": "worldcup-viral-shorts",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write --ignore-unknown .",
    "format:check": "prettier --check --ignore-unknown .",
    "prepare": "husky",
    "tools:yt-dlp": "bin/yt-dlp --version",
    "typecheck": "tsc --noEmit",
    "verify:pipeline": "tsx scripts/verify-pipeline.ts --mode dry-run --limit 1 --no-publish --strict",
    "verify:pipeline:4": "tsx scripts/verify-pipeline.ts --mode dry-run --limit 4 --no-publish --strict",
    "verify:clipping": "tsx scripts/verify-clipping.ts --mode dry-run --limit 1 --no-publish --strict",
    "verify:clipping:real": "tsx scripts/verify-clipping.ts --mode real --limit 2 --no-publish --strict",
    "verify:clipping:guards": "tsx scripts/verify-clipping-guards.ts",
    "verify:deploy": "tsx scripts/verify-deploy-safety.ts",
    "verify:env": "tsx scripts/verify-env-contract.ts",
    "verify:pm2": "tsx scripts/verify-pm2-config.ts",
    "verify:public-api": "tsx scripts/verify-public-api-safety.ts",
    "verify:n8n:prod": "tsx scripts/verify-n8n-runbook.ts",
    "verify:telegram:auth": "tsx scripts/verify-telegram-auth.ts",
    "verify:telegram:contracts": "tsx scripts/verify-telegram-contracts.ts",
    "verify:telegram:queue": "tsx scripts/verify-telegram-queue.ts",
    "verify:telegram:prod": "tsx scripts/verify-telegram-prod.ts",
    "verify:telegram:clip-live": "tsx scripts/verify-telegram-live-clip.ts",
    "verify:analytics": "tsx scripts/verify-analytics.ts",
    "verify:prod:local": "bash deploy/verify-local-prod.sh",
    "verify:vps": "bash deploy/verify-vps-prereqs.sh",
    "deploy:vps": "bash deploy/deploy-app.sh",
    "setup:vps": "bash deploy/setup-hostinger-vps.sh",
    "configure:nginx": "bash deploy/configure-nginx.sh",
    "collect:cutover-evidence": "bash deploy/collect-cutover-evidence.sh",
    "cleanup:output": "bash deploy/cleanup-output.sh"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "next": "^15.5.19",
    "openai": "^4.56.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.4"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.48.0",
    "@typescript-eslint/parser": "^8.48.0",
    "eslint": "^9.39.4",
    "eslint-config-next": "^15.5.19",
    "eslint-config-prettier": "^10.1.8",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.8.4",
    "typescript": "^5.5.3"
  },
  "overrides": {
    "postcss": "^8.5.10"
  }
}
